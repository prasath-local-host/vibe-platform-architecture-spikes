  "info": {
    "title": "Vibe Coding Platform Control Plane",
    "description": "Architecture-spike contract for company-scoped application registration and asynchronous assessment.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Verified identity-provider access token. The local spike token is not for production use."
      }
    },
    "schemas": {
      "HttpErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401,
            "description": "HTTP status code."
          },
          "message": {
            "type": "string",
            "example": "Verified identity is required",
            "description": "Safe, human-readable failure summary."
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "ApplicationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "VCP application identifier."
          },
          "companyId": {
            "type": "string",
            "description": "Owning VCP company identifier.",
            "example": "company-a"
          },
          "name": {
            "type": "string",
            "description": "Company-visible application name.",
            "example": "Readiness portal"
          },
          "repositoryUrl": {
            "type": "string",
            "format": "uri",
            "description": "Approved source repository URL."
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Idempotency key accepted during registration."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC registration timestamp."
          }
        },
        "required": [
          "id",
          "companyId",
          "name",
          "repositoryUrl",
          "idempotencyKey",
          "createdAt"
        ]
      },
      "RegisterApplicationRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Company-visible application name.",
            "example": "Readiness portal",
            "minLength": 1,
            "maxLength": 120
          },
          "repositoryUrl": {
            "type": "string",
            "description": "HTTPS URL of the approved source repository.",
            "example": "https://github.com/example/readiness-portal",
            "format": "uri"
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Caller-generated key that makes retries return the original application.",
            "example": "register-readiness-portal-v1",
            "minLength": 8,
            "maxLength": 100
          }
        },
        "required": [
          "name",
          "repositoryUrl",
          "idempotencyKey"
        ]
      },
      "ValidationIssueResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "too_small",
            "description": "Zod validation issue code."
          },
          "path": {
            "example": [
              "idempotencyKey"
            ],
            "description": "Request-body property path. Numeric array indexes are serialized as values.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string",
            "example": "Too small: expected string to have >=8 characters"
          }
        },
        "required": [
          "code",
          "path",
          "message"
        ]
      },
      "SubmitAssessmentRequest": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "description": "Caller-generated key unique to this application assessment request.",
            "example": "assess-main-commit-v1",
            "minLength": 8,
            "maxLength": 100
          },
          "sourceRevision": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$",
            "description": "Immutable Git commit SHA to assess. Branch and tag names are not accepted.",
            "example": "0123456789abcdef0123456789abcdef01234567"
          }
        },
        "required": [
          "idempotencyKey",
          "sourceRevision"
        ]
      },
      "AssessmentResultResponse": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "example": "nextjs-web-application",
            "description": "Application profile derived from committed repository manifests."
          },
          "findings": {
            "example": [],
            "description": "Machine-produced readiness findings; empty when no findings are produced.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manifests": {
            "description": "Supported manifests detected at the repository root.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detectedStack": {
            "description": "Technology identifiers derived from committed manifests.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "profile",
          "findings",
          "manifests",
          "detectedStack"
        ]
      },
      "AssessmentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Assessment identifier used for status polling."
          },
          "companyId": {
            "type": "string",
            "description": "Owning VCP company identifier.",
            "example": "company-a"
          },
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "description": "Application being assessed."
          },
          "repositoryUrl": {
            "type": "string",
            "format": "uri",
            "description": "Repository URL copied from the registered application when queued."
          },
          "sourceRevision": {
            "type": "string",
            "description": "Immutable source commit assessed by the worker."
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Idempotency key accepted for this assessment."
          },
          "correlationId": {
            "type": "string",
            "description": "Correlation identifier retained from submission through worker audit events.",
            "example": "01J5VCPASSESSMENT"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ],
            "example": "queued",
            "description": "Asynchronous lifecycle state. Completed and failed are terminal."
          },
          "attempts": {
            "type": "number",
            "minimum": 0,
            "example": 0,
            "description": "Number of worker claims, including recovery claims after a stale lock."
          },
          "result": {
            "description": "Present only when status is completed.",
            "allOf": [
              {
                "$ref": "#/components/schemas/AssessmentResultResponse"
              }
            ]
          },
          "error": {
            "type": "string",
            "description": "Safe failure summary present only when status is failed.",
            "example": "Assessment worker could not process the request"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC submission timestamp."
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC timestamp of the most recent worker claim."
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC timestamp when the assessment entered a terminal state."
          }
        },
        "required": [
          "id",
          "companyId",
          "applicationId",
          "repositoryUrl",
          "sourceRevision",
          "idempotencyKey",
          "correlationId",
          "status",
          "attempts",
          "createdAt"
        ]
      },
      "SubmitBuildRequest": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100,
            "example": "build-main-commit-v1"
          },
          "sourceRevision": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$",
            "description": "Immutable Git commit SHA."
          },
          "packageManager": {
            "type": "string",
            "enum": [
              "npm",
              "pnpm",
              "yarn"
            ]
          },
          "script": {
            "type": "string",
            "enum": [
              "build",
              "test"
            ]
          }
        },
        "required": [
          "idempotencyKey",
          "sourceRevision",
          "packageManager",
          "script"
        ]
      },
      "BuildResultResponse": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "format": "uuid"
          },
          "artifactDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "restorationStatus": {
            "type": "string",
            "enum": [
              "succeeded"
            ]
          },
          "buildStatus": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed"
            ]
          },
          "securityStatus": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "securityScanner": {
            "type": "string",
            "example": "vcp-baseline-artifact-security/1"
          },
          "securityScannedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "artifactId",
          "artifactDigest",
          "restorationStatus",
          "buildStatus",
          "securityStatus",
          "securityScanner",
          "securityScannedAt"
        ]
      },
      "BuildRecordResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "companyId": {
            "type": "string"
          },
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "repositoryUrl": {
            "type": "string",
            "format": "uri"
          },
          "sourceRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "packageManager": {
            "type": "string",
            "enum": [
              "npm",
              "pnpm",
              "yarn"
            ]
          },
          "script": {
            "type": "string",
            "enum": [
              "build",
              "test"
            ]
          },
          "idempotencyKey": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ]
          },
          "attempts": {
            "type": "number",
            "minimum": 0
          },
          "result": {
            "$ref": "#/components/schemas/BuildResultResponse"
          },
          "error": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "companyId",
          "applicationId",
          "repositoryUrl",
          "sourceRevision",
          "packageManager",
          "script",
          "idempotencyKey",
          "correlationId",
          "status",
          "attempts",
          "createdAt"
        ]
      },
      "CreateReleaseRequest": {
        "type": "object",
        "properties": {
          "buildId": {
            "type": "string",
            "format": "uuid",
            "description": "Completed build whose verified artifact will be deployed."
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100,
            "example": "release-test-commit-v1"
          }
        },
        "required": [
          "buildId",
          "idempotencyKey"
        ]
      },
      "ReleaseRecordResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "companyId": {
            "type": "string"
          },
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "buildId": {
            "type": "string",
            "format": "uuid"
          },
          "artifactId": {
            "type": "string",
            "format": "uuid"
          },
          "artifactDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "environment": {
            "type": "string",
            "enum": [
              "test"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "deploying",
              "healthy",
              "failed",
              "rolled-back"
            ]
          },
          "idempotencyKey": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "rollbackTargetReleaseId": {
            "type": "string",
            "format": "uuid"
          },
          "deploymentUrl": {
            "type": "string",
            "format": "uri"
          },
          "error": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "deployedAt": {
            "type": "string",
            "format": "date-time"
          },
          "healthVerifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "companyId",
          "applicationId",
          "buildId",
          "artifactId",
          "artifactDigest",
          "environment",
          "status",
          "idempotencyKey",
          "correlationId",
          "createdAt"
        ]
      }
    }
  }
}
