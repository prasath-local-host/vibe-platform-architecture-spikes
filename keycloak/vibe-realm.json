{
  "realm": "vibe",
  "enabled": true,
  "displayName": "Vibe Coding Platform",
  "accessTokenLifespan": 300,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "clients": [
    {
      "clientId": "vibe-control-plane",
      "name": "Vibe Coding Platform Portal",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-bff-client-only",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://127.0.0.1:3000/auth/callback", "http://127.0.0.1:3000/portal/*"],
      "attributes": {
        "post.logout.redirect.uris": "http://127.0.0.1:3000/portal/*",
        "pkce.code.challenge.method": "S256"
      },
      "webOrigins": ["http://127.0.0.1:3000"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "vibe-control-plane audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vibe-control-plane",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "authentication context",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "authentication methods",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "vibe-operator",
      "firstName": "Vibe",
      "lastName": "Operator",
      "email": "vibe-operator@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [{ "type": "password", "value": "local-demo-only", "temporary": false }]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "company-user",
      "firstName": "Company",
      "lastName": "User",
      "email": "company-user@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "local-demo-only", "temporary": false }]
    }
  ]
}
