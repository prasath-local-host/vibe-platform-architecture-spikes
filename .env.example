PORT=3000
DATABASE_URL=postgres://vibe:vibe-development-only@localhost:5432/vibe_control
SPIKE_IDENTITY_ENABLED=false
SPIKE_IDENTITY_GRANTS=[]
OIDC_ISSUER_URL=http://localhost:8081/realms/vibe
OIDC_AUDIENCE=vibe-control-plane
OIDC_CLIENT_ID=vibe-control-plane
OIDC_CLIENT_SECRET=replace-through-secret-management
OIDC_INTROSPECTION_ENABLED=true
OIDC_ALLOW_HTTP=true
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Comma-separated ACR values accepted for platform operators. Keep empty only for local spike login.
PRIVILEGED_AUTHENTICATION_CONTEXTS=
ASSESSMENT_WORKER_ENABLED=true
ASSESSMENT_WORKER_ID=local-worker
