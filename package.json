{
  "name": "vibe-platform-architecture-spikes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p portal/tsconfig.json --noEmit && vite build --config portal/vite.config.ts",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "portal:dev": "vite --config portal/vite.config.ts",
    "portal:build": "vite build --config portal/vite.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "openapi:generate": "tsx src/generate-openapi.ts",
    "architecture:generate": "tsx src/generate-architecture-report.ts",
    "architecture:check": "tsx src/generate-architecture-report.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p portal/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.4.7",
    "fastify": "5.11.3",
    "kysely": "^0.28.5",
    "pg": "^8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "7.1.3",
    "vitest": "^3.2.4"
  }
}
